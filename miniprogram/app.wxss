page {
  background: #F5F6F8;
  font-size: 28rpx;
  color: #1D2129;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.appbar {
  background: #FF6B4A;
  padding: 28rpx 32rpx 32rpx;
  color: #fff;
}
.appbar-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.appbar-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}
.appbar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.appbar-plain {
  background: #fff;
  color: #1D2129;
  border-bottom: 1rpx solid #E5E6EB;
  padding: 20rpx 32rpx;
}

.cats {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #E5E6EB;
  white-space: nowrap;
}
.cat-chip {
  flex-shrink: 0;
  padding: 10rpx 26rpx;
  border-radius: 40rpx;
  background: #F5F6F8;
  font-size: 26rpx;
  color: #4E5969;
  border: 2rpx solid transparent;
}
.cat-chip.on {
  background: #FFF1ED;
  color: #FF6B4A;
  border-color: #FF6B4A;
  font-weight: 600;
}

.sort-bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx 0;
}
.sort-chip {
  font-size: 24rpx;
  color: #86909C;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  background: #fff;
}
.sort-chip.on {
  color: #FF6B4A;
  font-weight: 600;
}

.list {
  padding: 20rpx 24rpx 40rpx;
}

.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 20rpx rgba(0, 0, 0, 0.05);
}
.card-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.cat-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 10rpx;
  color: #fff;
  font-weight: 600;
}
.city {
  font-size: 22rpx;
  color: #86909C;
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.45;
  margin-bottom: 10rpx;
}
.card-desc {
  font-size: 26rpx;
  color: #86909C;
  line-height: 1.6;
  margin-bottom: 20rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.options {
  margin-bottom: 20rpx;
}
.opt {
  display: flex;
  align-items: center;
  position: relative;
  padding: 14rpx 20rpx;
  background: #F5F6F8;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  overflow: hidden;
}
.opt-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: #FFE7DE;
  z-index: 0;
}
.opt-text {
  position: relative;
  z-index: 1;
  flex: 1;
  font-size: 26rpx;
  color: #4E5969;
}
.opt-pct {
  position: relative;
  z-index: 1;
  font-size: 22rpx;
  color: #86909C;
  font-weight: 600;
}
.opt.pick .opt-text {
  color: #1D2129;
  font-weight: 600;
}

.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
  border-top: 1rpx solid #F2F3F5;
  font-size: 24rpx;
  color: #86909C;
}
.foot-left {
  display: flex;
  gap: 24rpx;
}
.badge-adopt {
  color: #FA8C16;
  font-weight: 600;
}

.empty {
  text-align: center;
  padding: 140rpx 60rpx;
}
.empty-ico {
  font-size: 88rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: #86909C;
  line-height: 1.7;
}

.form {
  padding: 28rpx 32rpx;
}
.form-group {
  margin-bottom: 36rpx;
}
.form-label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}
.form-label-req {
  color: #FF6B4A;
  margin-left: 6rpx;
}
.form-label-tip {
  font-size: 22rpx;
  color: #86909C;
  font-weight: 400;
  margin-left: 10rpx;
}
.input,
.textarea {
  width: 100%;
  background: #fff;
  border: 2rpx solid #E5E6EB;
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.textarea {
  height: 180rpx;
  line-height: 1.6;
}
.hint {
  font-size: 22rpx;
  color: #86909C;
  margin-top: 12rpx;
  line-height: 1.6;
}

.pick-cats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.pick-cat {
  padding: 14rpx 28rpx;
  border-radius: 36rpx;
  border: 2rpx solid #E5E6EB;
  background: #fff;
  font-size: 26rpx;
}
.pick-cat.on {
  background: #FF6B4A;
  border-color: #FF6B4A;
  color: #fff;
  font-weight: 600;
}

.opt-input {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 16rpx;
}
.opt-idx {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #F5F6F8;
  color: #86909C;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.del-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F5F6F8;
  color: #86909C;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}
.add-opt {
  font-size: 26rpx;
  color: #FF6B4A;
  padding: 10rpx 0;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
}

.actionbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid #E5E6EB;
  padding: 18rpx 24rpx calc(18rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 20rpx;
}
.btn {
  height: 88rpx;
  border-radius: 44rpx;
  border: none;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}
.btn-primary {
  flex: 1;
  background: #FF6B4A;
  color: #fff;
}
.btn-ghost {
  width: 190rpx;
  background: #F5F6F8;
  color: #4E5969;
}

.detail-card {
  background: #fff;
  padding: 32rpx;
}
.detail-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.45;
  margin-bottom: 16rpx;
}
.detail-desc {
  font-size: 28rpx;
  color: #4E5969;
  line-height: 1.7;
  margin-bottom: 28rpx;
}
.asker {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 28rpx;
}
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9A76, #FF6B4A);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar-sm {
  width: 56rpx;
  height: 56rpx;
  font-size: 22rpx;
}
.asker-name {
  font-size: 26rpx;
  font-weight: 600;
}
.asker-time {
  font-size: 22rpx;
  color: #86909C;
  margin-top: 4rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #86909C;
  padding: 32rpx 32rpx 16rpx;
}
.answer {
  background: #fff;
  margin: 0 24rpx 20rpx;
  border-radius: 28rpx;
  padding: 28rpx;
  position: relative;
  box-shadow: 0 2rpx 20rpx rgba(0, 0, 0, 0.05);
}
.answer.adopted {
  border: 3rpx solid #FA8C16;
}
.adopt-flag {
  position: absolute;
  top: 0;
  right: 24rpx;
  background: #FA8C16;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 0 0 12rpx 12rpx;
}
.answer-content {
  font-size: 29rpx;
  line-height: 1.75;
  margin: 22rpx 0 24rpx;
}
.rec {
  background: #FFF1ED;
  border-radius: 16rpx;
  padding: 16rpx 22rpx;
  font-size: 26rpx;
  color: #FF6B4A;
  margin-bottom: 20rpx;
}
.answer-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.like {
  font-size: 24rpx;
  color: #86909C;
  background: #F5F6F8;
  padding: 8rpx 22rpx;
  border-radius: 30rpx;
}
.like.on {
  background: #FFF1ED;
  color: #FF6B4A;
}
.adopt-btn {
  font-size: 25rpx;
  color: #FA8C16;
  font-weight: 600;
}

.profile {
  background: linear-gradient(135deg, #FF8A65, #FF6B4A);
  padding: 48rpx 32rpx 56rpx;
  color: #fff;
}
.profile-top {
  display: flex;
  align-items: center;
  gap: 26rpx;
}
.profile .avatar {
  width: 112rpx;
  height: 112rpx;
  font-size: 40rpx;
  background: rgba(255, 255, 255, 0.25);
}
.profile-name {
  font-size: 36rpx;
  font-weight: 700;
}
.profile-sub {
  font-size: 24rpx;
  opacity: 0.88;
  margin-top: 8rpx;
}
.stats {
  display: flex;
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx 0;
  margin: -24rpx 24rpx 24rpx;
  position: relative;
}
.stat {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 42rpx;
  font-weight: 700;
  color: #FF6B4A;
}
.stat-label {
  font-size: 22rpx;
  color: #86909C;
  margin-top: 6rpx;
}
.stat-sep {
  width: 1rpx;
  background: #E5E6EB;
}
.menu {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 28rpx;
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 30rpx 32rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #F2F3F5;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-ico {
  font-size: 34rpx;
  width: 44rpx;
}
.menu-arrow {
  margin-left: auto;
  color: #C9CDD4;
  font-size: 34rpx;
}

.load-more {
  text-align: center;
  padding: 30rpx 0 50rpx;
  font-size: 24rpx;
  color: #86909C;
}
