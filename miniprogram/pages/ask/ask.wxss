.form-scroll {
  height: calc(100vh - 180rpx - 140rpx);
}

/* 草稿恢复提示 */
.draft-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  margin-bottom: 24rpx;
  background: #FFF7E8;
  border-radius: 16rpx;
}
.draft-hint-text {
  font-size: 24rpx;
  color: #FA8C16;
}
.draft-hint-clear {
  font-size: 24rpx;
  color: #86909C;
  padding: 4rpx 12rpx;
}
