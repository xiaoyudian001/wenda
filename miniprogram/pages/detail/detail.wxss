/* 回答输入面板 */
.reply-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.reply-panel {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
}
.reply-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.reply-textarea {
  width: 100%;
  height: 220rpx;
  background: #F5F6F8;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}
.reply-count {
  text-align: right;
  font-size: 22rpx;
  color: #86909C;
  margin: 12rpx 0 24rpx;
}
.reply-submit {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #FF6B4A;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

/* 投票后的高亮 */
.opt.mine {
  border-color: #FF6B4A;
}
.opt.mine .opt-text {
  color: #FF6B4A;
  font-weight: 600;
}

.vote-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #86909C;
}

/* 详情页底部操作行 */
.detail-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #F2F3F5;
}
.dact {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #4E5969;
  background: #F5F6F8;
  border-radius: 36rpx;
}

/* 回答底部的举报入口 */
.answer-foot-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.report-link {
  font-size: 23rpx;
  color: #86909C;
}

/* 回答时选“我选哪个” */
.reply-pick {
  margin-bottom: 22rpx;
}
.reply-pick-label {
  font-size: 26rpx;
  color: #4E5969;
  margin-bottom: 14rpx;
}
.reply-pick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.reply-pick-item {
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  background: #F5F6F8;
  font-size: 25rpx;
  color: #4E5969;
  border: 2rpx solid transparent;
}
.reply-pick-item.on {
  background: #FFF1ED;
  color: #FF6B4A;
  border-color: #FF6B4A;
  font-weight: 600;
}

/* 举报理由 */
.report-list {
  margin-bottom: 24rpx;
}
.report-item {
  padding: 22rpx 24rpx;
  margin-bottom: 12rpx;
  background: #F5F6F8;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #4E5969;
  border: 2rpx solid transparent;
}
.report-item.on {
  background: #FFF1ED;
  color: #FF6B4A;
  border-color: #FF6B4A;
  font-weight: 600;
}
