.review-hero {
  padding: 36rpx 32rpx 28rpx;
  background: linear-gradient(135deg, #FF6B4A 0%, #FF8A65 100%);
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.hero-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.5;
}

.review-stats {
  display: flex;
  background: #fff;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}

.rstat {
  flex: 1;
  text-align: center;
}

.rstat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1D2129;
}

.rstat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #86909C;
}

.reason-card {
  margin: 24rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
}

.reason-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.reason-label {
  font-size: 28rpx;
  color: #1D2129;
}

.reason-pct {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B4A;
}

.reason-bar {
  margin-top: 18rpx;
  height: 16rpx;
  background: #F2F3F5;
  border-radius: 8rpx;
  overflow: hidden;
}

.reason-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B4A, #FF8A65);
  border-radius: 8rpx;
}

.reason-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #86909C;
  line-height: 1.5;
}

.list {
  padding: 0 24rpx 60rpx;
}
